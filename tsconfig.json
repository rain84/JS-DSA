{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"inlineSourceMap": true,
		"lib": ["DOM", "ESNext", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"outDir": "out",
		"paths": {
			"*": ["./src/*"]
		},
		"strict": true,
		"target": "ESNext",
		"types": ["vitest/globals", "node"]
	},
	"exclude": ["node_modules", "./src/**/*.spec.ts", ".vscode", "coverage"],
	"include": ["src/**/*.ts", "src/**/*.test.ts"]
}
